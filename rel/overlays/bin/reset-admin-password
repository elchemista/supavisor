#!/bin/sh
set -eu

case "${1:-}" in
  -h|--help)
    printf '%s\n' 'Usage: bin/reset-admin-password [ADMIN_EMAIL]' 'Resets the password on the running release and prints it once.' 'Use the service account and the release environment. No password argument is accepted.'
    exit 0
    ;;
esac
if [ "$#" -gt 1 ]; then
  printf '%s\n' 'Usage: bin/reset-admin-password [ADMIN_EMAIL]' >&2
  exit 2
fi

cd -P -- "$(dirname -- "$0")"
expression='Supavisor.Release.reset_admin_password()'
if [ "$#" -eq 1 ]; then
  # Only base64 data enters the RPC expression; email text cannot become Elixir code.
  encoded_email=$(printf '%s' "$1" | base64 | tr -d '\n')
  expression="Supavisor.Release.reset_admin_password(Base.decode64!(\"$encoded_email\"))"
fi
exec ./supavisor rpc "$expression"
