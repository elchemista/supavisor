#!/bin/sh
set -eu

case "${1:-}" in
  -h|--help)
    printf '%s\n' 'Usage: sudo supavisor-admin-password [ADMIN_EMAIL]' 'Generates a new password for an existing administrator and prints it once.' 'Requires the running Supavisor service. Does not send email.'
    exit 0
    ;;
esac
if [ "$#" -gt 1 ]; then
  printf '%s\n' 'Usage: sudo supavisor-admin-password [ADMIN_EMAIL]' >&2
  exit 2
fi
if [ "$(id -u)" -ne 0 ]; then
  printf '%s\n' 'Run this command with sudo.' >&2
  exit 1
fi
if ! systemctl is-active --quiet supavisor; then
  printf '%s\n' 'Supavisor is not running. Start it with: sudo systemctl start supavisor' >&2
  exit 1
fi

# --pipe sends the generated password to this terminal, not to the service journal.
exec systemd-run --quiet --wait --pipe --collect \
  -p User=supavisor -p Group=supavisor \
  -p WorkingDirectory=/opt/supavisor/current \
  -p EnvironmentFile=/etc/supavisor/supavisor.env \
  /opt/supavisor/current/bin/reset-admin-password "$@"
