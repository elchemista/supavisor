# Copy to /etc/supavisor/supavisor.env (root:root, 0600).
# This file is read by systemd. Use literal values, without `export` or shell commands.
DATABASE_URL=ecto://supavisor:REPLACE_PASSWORD@127.0.0.1:5432/supavisor
SECRET_KEY_BASE=REPLACE_WITH_OPENSSL_RAND_HEX_64
VAULT_ENC_KEY=REPLACE_WITH_EXACTLY_32_CHARACTERS
API_JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
METRICS_JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
RELEASE_COOKIE=REPLACE_WITH_OPENSSL_RAND_HEX_32

PORT=4000
HTTP_BIND_ADDRESS=127.0.0.1
PROXY_BIND_ADDRESS=127.0.0.1
# Set true only behind a local reverse proxy which replaces X-Forwarded-* headers.
TRUST_PROXY_HEADERS=false
ADMIN_BASE_URL=http://localhost:4000
POOLER_HOST=localhost
ADMIN_EMAILS=admin@example.com
ADMIN_EMAIL_FROM=admin@example.com
REGION=local
NODE_IP=127.0.0.1
CLUSTER_POSTGRES=false
PROXY_PORT_SESSION=5452
PROXY_PORT_TRANSACTION=6543
ERL_AFLAGS="-kernel inet_dist_use_interface {127,0,0,1}"
ERL_EPMD_ADDRESS=127.0.0.1

# Existing PostgreSQL server: needed for server overview and optional provisioning.
# Provisioning requires permission to create roles and databases owned by those roles.
# Use a PostgreSQL administrator for this optional operation.
ADMIN_PROVISIONING_ENABLED=false
ADMIN_POSTGRES_HOST=127.0.0.1
ADMIN_POSTGRES_PORT=5432
ADMIN_POSTGRES_DATABASE=postgres
ADMIN_POSTGRES_USER=postgres
ADMIN_POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
ADMIN_POSTGRES_SSL=false

# Optional SMTP. Without SMTP, create an admin link using the release RPC command.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=admin@example.com
# SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
# SMTP_SSL=false

# Models and private DKIM keys must survive release upgrades.
SERVICE_DATA_DIR=/var/lib/supavisor/services
# Optional self-hosted ONNX graph runtime. No graphs load at startup.
# This directory contains stt/, tts/ and ai/, outside versioned application releases.
LOCAL_ONNX_ENABLED=false
# LOCAL_ONNX_MODEL_DIR=/var/lib/supavisor/services/onnx-models/current
# Enable receiving only after configuring your MX, firewall and TLS.
SERVICE_SMTP_ENABLED=false
SERVICE_SMTP_BIND=127.0.0.1
SERVICE_SMTP_PORT=2525
SERVICE_SMTP_HOSTNAME=mail.example.com
# SERVICE_SMTP_CERTFILE=/etc/supavisor/mail/fullchain.pem
# SERVICE_SMTP_KEYFILE=/etc/supavisor/mail/privkey.pem

# Optional automatic removal of completed messages; 0 keeps messages.
SERVICE_MAIL_RETENTION_DAYS=0

# Database exports and imports. Install matching PostgreSQL client tools; the release includes its Rust worker.
# Files stay under SERVICE_DATA_DIR by default and survive release upgrades.
# BACKUP_DIRECTORY=/var/lib/supavisor/services/backups
# Use a unique, stable identity per instance, especially when replacing hosts.
# BACKUP_NODE_ID=postgres-console-01
# BACKUP_PG_BIN=/usr/lib/postgresql/18/bin
# BACKUP_MAX_BYTES=2147483648
# BACKUP_QUOTA_BYTES=21474836480
# BACKUP_TIMEOUT_SECONDS=3600

# Speech requires OS packages: ffmpeg espeak-ng
# SERVICE_DATA_DIR/tmp holds private audio (72h retention), not model weights.
